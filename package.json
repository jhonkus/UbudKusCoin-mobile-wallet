{
  "name": "ubudkuscoinmobilewallet",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "update-app-version": "npx react-native-version --never-amend"
  },
  "dependencies": {
    "@ethersproject/shims": "^5.8.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "ethers": "^5.8.0",
    "react": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.26.2",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "^15.15.5",
    "react-native-vision-camera": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@types/assert": "^1.5.6",
    "@types/babel__core": "^7.1.17",
    "@types/events": "^1.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.1",
    "@types/react-native-get-random-values": "~1.8.2",
    "@types/react-test-renderer": "^19.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community|-async-storage)?|@react-navigation|react-native-size-matters|react-native-qrcode-svg)/)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "collectCoverageFrom": [
      "src/domain/**/*.ts",
      "src/infrastructure/**/*.ts",
      "src/data/**/*.ts",
      "src/protocol/**/*.ts",
      "!src/**/__tests__/**",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
